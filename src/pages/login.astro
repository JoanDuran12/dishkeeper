---
---
<html lang="en">
  <head>
    <title>Log In</title>
    <meta charset="UTF-8" />
  </head>
  <body class="p-8 font-sans bg-gray-100 min-h-screen">
    <h1 class="text-2xl font-bold mb-4">Login</h1>

    <form id="loginForm" class="max-w-sm bg-white p-6 rounded shadow">
      <label class="block mb-4">
        Username:
        <input
          type="text"
          name="username"
          required
          class="mt-1 w-full border px-3 py-2 rounded"
        />
      </label>

      <label class="block mb-4">
        Password:
        <input
          type="password"
          name="password"
          required
          class="mt-1 w-full border px-3 py-2 rounded"
        />
      </label>

      <button
        type="submit"
        class="bg-black text-white px-4 py-2 rounded hover:bg-gray-800"
      >
        Log In
      </button>
    </form>

    <p class="mt-4 text-sm text-center">
      Don't have an account?
      <a href="/register" class="text-blue-600 hover:underline">Register instead</a>
    </p>

    <script type="module">
      const form = document.getElementById("loginForm");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const username = form.username.value;
        const password = form.password.value;

        const res = await fetch("http://localhost:5000/api/auth/login", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ username, password }),
        });

        const data = await res.json();

        if (res.ok) {
          localStorage.setItem("token", data.token);
          alert("Login successful!");
          window.location.href = "/";
        } else {
          alert(data.message || "Login failed.");
        }
      });
    </script>
  </body>
</html>
