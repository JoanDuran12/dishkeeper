---
import ClockIcon from "../icons/Clock.astro";
import StarIcon from "../icons/Star.astro";

const { id, title, owner, time, rating, type, image } = Astro.props;
---

<a href={`/recipe/${id}`} class="block overflow-hidden rounded-2xl border border-gray-300 mb-4 hover:shadow-md transition">
  <div class="relative aspect-video overflow-hidden">
    <img 
      src={image || "https://via.placeholder.com/300x200"}
      alt={title}
      class="w-full h-full object-cover transition-transform hover:scale-105"
    />
    <span class="absolute right-2 top-2 px-2 py-1 bg-white/80 rounded text-sm">{type}</span>
  </div>
  <div class="p-4">
    <h3 class="text-lg font-semibold">{title}</h3>
    <p class="text-sm text-gray-600 mb-2">{owner}</p>
    <div class="flex justify-between text-sm mt-2 text-gray-500">
      <span class="flex items-center"><ClockIcon class="w-4 h-4 mr-1" /> {time}</span>
      <span class="flex items-center"><StarIcon class="w-4 h-4 mr-1" /> {rating}</span>
    </div>
  </div>
</a>
